// Modèle de persistance Nexus AI (cahier maître §11).
// `Event` est la source de vérité, en ajout seul. Les autres modèles sont des projections matérialisées,
// écrites dans la même transaction que l'événement qui les modifie (NFR-002).
// Les charges JSON sont stockées en texte, déjà expurgées : aucun secret n'atteint la base (NFR-008).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  // Forge exécute le process principal dans un bundle CommonJS. Le client généré CJS
  // évite `import.meta.url`, indisponible dans ce bundle.
  moduleFormat           = "cjs"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Event {
  globalSequence       Int      @id @default(autoincrement())
  eventId              String   @unique
  aggregateType        String
  aggregateId          String
  aggregateVersion     Int
  eventType            String
  payloadSchemaVersion Int
  payloadJson          String
  occurredAt           String
  correlationId        String
  causationId          String?
  actorType            String
  actorId              String
  recordedAt           String

  @@unique([aggregateId, aggregateVersion])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("events")
}

model Project {
  id              String   @id
  name            String
  rootPath        String   @unique
  isGitRepository Boolean
  protectEnvFiles Boolean  @default(false)
  createdAt       String
  updatedAt       String
  version         Int
  teams           Team[]
  missions        Mission[]

  @@map("projects")
}

model Team {
  id             String         @id
  projectId      String
  name           String
  governanceMode String
  supervisorId   String?
  createdAt      String
  updatedAt      String
  version        Int
  project        Project        @relation(fields: [projectId], references: [id])
  members        AgentProfile[]

  @@unique([projectId, name])
  @@map("teams")
}

model AgentProfile {
  id                  String  @id
  teamId              String
  role                String
  displayName         String
  connectorId         String
  providerAccountId   String?
  permissionMode      String
  authMode            String  @default("vendor-login")
  capabilitiesJson    String
  createdAt           String
  updatedAt           String
  version             Int
  team                Team    @relation(fields: [teamId], references: [id])

  @@map("agent_profiles")
}

/// Métadonnées de compte uniquement : jamais de jeton ni de clé (coffre de l'OS, T-015).
model ProviderAccount {
  id           String @id
  providerId   String
  label        String
  authMode     String
  secretRef    String?
  createdAt    String
  updatedAt    String

  @@unique([providerId, label])
  @@map("provider_accounts")
}

model Mission {
  id          String  @id
  projectId   String
  teamId      String
  title       String
  prompt      String
  status      String
  createdAt   String
  updatedAt   String
  version     Int
  project     Project @relation(fields: [projectId], references: [id])
  tasks       Task[]

  @@index([projectId])
  @@map("missions")
}

model Task {
  id                String  @id
  missionId         String
  title             String
  description       String
  status            String
  assignedAgentId   String?
  allowedPathsJson  String
  acceptanceJson    String
  attempt           Int     @default(0)
  maxAttempts       Int     @default(2)
  lastFailureCode   String?
  planKey           String?
  createdAt         String
  updatedAt         String
  version           Int
  mission           Mission @relation(fields: [missionId], references: [id])

  @@index([missionId, status])
  @@map("tasks")
}

model TaskDependency {
  taskId      String
  dependsOnId String

  @@id([taskId, dependsOnId])
  @@map("task_dependencies")
}

model Session {
  id              String  @id
  projectId       String
  agentProfileId  String
  title           String
  createdAt       String
  updatedAt       String

  @@index([projectId])
  @@map("sessions")
}

model AgentRun {
  id               String  @id
  taskId           String
  sessionId        String
  connectorId      String
  connectorVersion String?
  nativeSessionId  String?
  pid              Int?
  runnerInstanceId String?
  status           String
  startedAt        String
  endedAt          String?
  lastSequence     Int     @default(0)

  @@index([taskId])
  @@index([status])
  @@map("agent_runs")
}

model Message {
  id               String  @id
  missionId        String
  taskId           String?
  senderAgentId    String
  recipientAgentId String?
  type             String
  body             String
  payloadRef       String?
  correlationId    String
  inReplyTo        String?
  timestamp        String

  @@index([missionId, timestamp])
  @@map("messages")
}

model Artifact {
  id          String @id
  missionId   String
  taskId      String?
  name        String
  version     Int
  mediaType   String
  contentRef  String
  sha256      String
  publishedBy String
  createdAt   String

  @@unique([missionId, name, version])
  @@map("artifacts")
}

model Approval {
  id              String  @id
  action          String
  projectId       String
  taskId          String?
  summary         String
  planFingerprint String
  status          String
  requestedAt     String
  expiresAt       String
  decidedAt       String?

  @@index([status])
  @@map("approvals")
}

model Worktree {
  id         String  @id
  projectId  String
  taskId     String  @unique
  path       String  @unique
  branch     String
  baseRef    String
  status     String
  createdAt  String
  removedAt  String?

  @@map("worktrees")
}

model Decision {
  id         String @id
  projectId  String
  title      String
  body       String
  status     String
  source     String
  scope      String
  confidence String
  createdAt  String
  version    Int

  @@map("decisions")
}

model MemoryEntry {
  id         String @id
  projectId  String
  kind       String
  content    String
  source     String
  scope      String
  confidence String
  createdAt  String
  version    Int

  @@index([projectId, kind])
  @@map("memory_entries")
}

model UsageSnapshot {
  id           String  @id
  connectorId  String
  accountId    String?
  observedAt   String
  source       String
  remaining    Float?
  consumed     Float?
  unit         String?
  windowEnd    String?
  caveat       String?

  @@index([connectorId, observedAt])
  @@map("usage_snapshots")
}

model DeploymentRun {
  id          String  @id
  projectId   String
  target      String
  environment String
  status      String
  url         String?
  approvalId  String?
  logRef      String?
  createdAt   String
  updatedAt   String

  @@map("deployment_runs")
}

model VoiceTranscript {
  id          String  @id
  projectId   String
  engine      String
  language    String
  rawText     String
  editedText  String?
  sentAt      String?
  audioKept   Boolean
  createdAt   String

  @@map("voice_transcripts")
}

model PermissionPolicy {
  id          String @id
  name        String @unique
  mode        String
  rulesJson   String
  createdAt   String
  updatedAt   String

  @@map("permission_policies")
}
